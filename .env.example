# Server Configuration
PORT=3000
HOST=localhost
# A separate read-only preview server (defaults to PORT + 1).
PREVIEW_PORT=3001
# Optional public preview origin, distinct from the studio origin.
# {projectId} provides per-project browser storage isolation behind a proxy.
# PREVIEW_ORIGIN=https://{projectId}.preview.example.com

# Storage: filesystem by default; a Mongo URI enables MongoDB + GridFS.
MONGO_URI=
MONGO_DB_NAME=orchestra
# Force local storage even if a Mongo URI is configured:
# ORCHESTRA_STORAGE=filesystem
# Optional parent directory for projects/ and workspace/ (default: repo root).
# ORCHESTRA_DATA_DIR=/path/to/orchestra-data

# Model Provider API Keys
# NVIDIA NIM API Key (required for moonshotai/kimi-k3)
NVIDIA_API_KEY=

# Google Gemini API Key (required for gemini-3.5-flash)
GEMINI_API_KEY=

# OpenRouter API Key (required for the Qwen routing option)
OPENROUTER_API_KEY=
