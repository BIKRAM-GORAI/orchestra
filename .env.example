# Server Configuration
PORT=3000
HOST=localhost

# MongoDB Database URI (required for project persistence and versioning)
MONGO_URI=

# Model Provider API Keys

# 1. Mistral AI API Key (Required for Codestral Latest - Free/Budget Tier, 16k output tokens)
# Get your API key at: https://console.mistral.ai/
MISTRAL_API_KEY=

# 2. NVIDIA NIM API Key (Required for Moonshot AI Kimi K3 - Standard Reasoning Tier)
# Get your API key at: https://build.nvidia.com/
NVIDIA_API_KEY=

# 3. Google Gemini API Key (Required for Gemini 3.5 Flash / Flash-Lite - Premium / Lead Tier)
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=

# 4. OpenRouter API Key (DISCONTINUED / DEPRECATED)
# OpenRouter free tier models (e.g. Qwen) have been discontinued and replaced with Mistral Codestral
# due to output token clamping and truncation limitations. Kept only for legacy backwards-compatibility.
# OPENROUTER_API_KEY=
